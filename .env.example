# ─── Django ───────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ─── API Keys ─────────────────────────────────────────────────────
# Clé API Anthropic (Claude) — https://platform.claude.com/ → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Modèle Claude utilisé par l'assistant IA (optionnel)
CLAUDE_MODEL=claude-sonnet-5-5
# Clé Fernet pour chiffrer les clés API personnelles des utilisateurs
# Générer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# ─── Google OAuth (optional) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Query Limits ─────────────────────────────────────────────────
FREE_QUERIES_PER_DAY=5
ANONYMOUS_QUERIES_LIMIT=2
